# Copy this file to `.env` and fill in your keys:  cp .env.example .env
# `.env` is gitignored — never commit real keys.
#
# All three keys are optional depending on which pipeline you run — see the
# "Which keys does each pipeline need?" table in README.md. A pipeline that
# needs a key it can't find will fail fast.

# Serper (google.serper.dev) — Maps + Web search.
# Used by: the generic pipeline discovery/press steps, awards/directories
# discovery, best_wine_shops search, the job-board lane.
SERPER_API_KEY=

# Apify (apify.com) — runs the Instagram / Google-Reviews / OpenTable / Beli
# scrapers. Billed per result — this is the biggest cost driver in the repo.
# Used by: generic-pipeline enrichment (instagram, reviews, reels, posts,
# availability), the Beli scraper, some scripts/ helpers.
APIFY_API_TOKEN=

# Anthropic (Claude) — LLM extraction from editorial articles and image OCR.
# Used by: awards/ LLM sources, best_wine_shops extraction, the Beli scraper.
# NOTE: if your shell already exports an empty ANTHROPIC_API_KEY (a known
# Claude Desktop side-effect), python-dotenv will NOT overwrite it. Prefix the
# command with `unset ANTHROPIC_API_KEY &&` in that case.
ANTHROPIC_API_KEY=
